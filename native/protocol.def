// Vocabulaire unique du JSON et du journal ; les noms sérialisés historiques restent inchangés.
GAD_PROTOCOL_VERSION(34)
GAD_STATE(Scanning, scanning, false)
GAD_STATE(Waiting, waiting, false)
GAD_STATE(DeviceWaiting, device_waiting, false)
GAD_STATE(Running, running, false)
GAD_STATE(Verifying, verifying, false)
GAD_STATE(Conflict, conflict, false)
GAD_STATE(Skipped, skipped, false)
GAD_STATE(Done, done, true)
GAD_STATE(Error, error, true)
GAD_STATE(Cancelled, cancelled, true)
GAD_STATE(UndoWaiting, undo_waiting, false)
GAD_STATE(Undoing, undoing, false)
GAD_STATE(Undone, undone, true)
GAD_STATE(UndoError, undo_error, true)
GAD_COMMAND(Status, status)
GAD_COMMAND(Poll, poll)
GAD_COMMAND(Configure, configure)
GAD_COMMAND(Enqueue, enqueue)
GAD_COMMAND(Pause, pause)
GAD_COMMAND(Cancel, cancel)
GAD_COMMAND(CancelMany, cancel_many)
GAD_COMMAND(UndoMany, undo_many)
GAD_COMMAND(Resolve, resolve)
GAD_COMMAND(CancelAll, cancel_all)
GAD_COMMAND(UndoAll, undo_all)
GAD_COMMAND(PauseSelection, pause_selection)
GAD_COMMAND(RetrySelection, retry_selection)
GAD_COMMAND(DeleteSelection, delete_selection)
GAD_COMMAND(BackspaceSelection, backspace_selection)
GAD_COMMAND(UndoSelection, undo_selection)
GAD_COMMAND(CancelSelection, cancel_selection)
GAD_COMMAND(Clear, clear)
GAD_COMMAND(Shutdown, shutdown)
GAD_COMMAND(Show, show)
GAD_COMMAND(Background, background)
GAD_COMMAND(Paste, paste)

GAD_COMMAND(ResumeInterrupted, resume_interrupted)

GAD_COMMAND(ReorderQueue, reorder_queue)

GAD_COMMAND(ReorderRows, reorder_rows)

GAD_COMMAND(SetRateLimit, set_rate_limit)

GAD_COMMAND(ErrorReport, error_report)
GAD_COMMAND(RetryErrors, retry_errors)

GAD_COMMAND(CompletionClaim, completion_claim)
GAD_COMMAND(CompletionRelease, completion_release)

GAD_COMMAND(SimulationBegin, simulation_begin)
GAD_COMMAND(Simulate, simulate)
GAD_COMMAND(SimulationCancel, simulation_cancel)

GAD_COMMAND(StartPrepared, start_prepared)
