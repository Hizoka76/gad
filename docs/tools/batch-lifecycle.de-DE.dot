// Request states; individual files have additional states described in the guide.
digraph cycle {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.40"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  scan [label="scanning\nVorbereitung"];
  waiting [label="waiting\nWarteschlange und Pausensteuerung"];
  running [label="running\nWorker reserviert"];
  device [label="device_waiting\nEinhängepunkt nicht verfügbar",fillcolor="#fff4da"];
  done [label="done", fillcolor="#e9f5ec"];
  error [label="error", fillcolor="#ffe9e7"];
  cancel [label="cancelled", fillcolor="#fff4da"];
  undo [label="undoing\nExklusiv"];
  undone [label="undone", fillcolor="#e9f5ec"];
  undoerr [label="undo_error", fillcolor="#ffe9e7"];
  scan -> waiting [label="Auftrag geprüft"]; scan -> error [label="Abgelehnt"]; scan -> cancel [label="Abgebrochen"];
  waiting -> running [label="Kompatible Ressourcen"]; waiting -> cancel [label="Abgebrochen"];
  running -> done [label="Erfolgreich"]; running -> waiting [label="Nächster Zweig / Neuplanung"];
  running -> device [label="Verbindung unterbrochen"]; scan -> device [label="Bekannter Einhängepunkt fehlt"];
  device -> waiting [label="Einhängepunkt und Dateien erneut geprüft"]; device -> error [label="Wiederaufnahme abgelehnt"]; device -> cancel [label="Abgebrochen"];
  running -> error [label="Fehler"]; running -> cancel [label="Gestoppt"];
  done -> undo [label="Wiederherstellen"]; error -> undo [label="Wiederherstellen / fehlerhafte Dateien wiederholen"]; error -> scan [label="Leere Vorbereitung wiederholen"]; cancel -> undo;
  undo -> undone [label="Wiederhergestellt"]; undo -> undoerr [label="Schutz / Fehler"]; undoerr -> undo [label="Erneut versuchen"];
  undo -> waiting [label="Wiederholung / Reaktivierung vorbereitet"];
}
