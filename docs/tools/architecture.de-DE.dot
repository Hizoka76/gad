// The UI and engine run inside one executable.
digraph architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.5"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  input [label="Dolphin / Konqueror / CLI\nKopieren, Ausschneiden, mit Gad einfügen"];
  socket [label="Eine Qt-Instanz\nPrivater Unix-Socket"];
  ui [label="Fenster, Menüs und Infobereich\nQSettings + Zeilencache"];
  kio [label="KIO Fuse\nURL → eingehängter Pfad\nKDE-Authentifizierung", fillcolor="#fff4da"];
  bridge [label="C-/JSON-Schnittstelle\nsc_request → sc_free"];
  prep [label="Vorbereitung im Hintergrund\nPrüfung und Dateierfassung"];
  engine [label="Gemeinsamer Rust-Zustand\nMutex + Condvar"];
  workers [label="Zwei Worker-Threads\nDatenträger- und Pfadreservierungen\nKopieren / Verschieben / Wiederherstellen"];
  fs [label="Lokale oder eingehängte Dateien\nTemporäre Dateien und Sicherungen", fillcolor="#e9f5ec"];
  journal [label="JSON-Journal\nAtomares Schreiben und Synchronisierung", fillcolor="#e9f5ec"];
  plasma [label="Plasma JobViewV3\nGesamtfortschritt", fillcolor="#fff4da"];
  input -> socket; socket -> ui; ui -> kio [label="Entfernte Endpunkte"]; kio -> ui [label="Pfade"];
  ui -> bridge; bridge -> engine; engine -> prep; prep -> engine;
  engine -> workers; workers -> fs; workers -> journal; engine -> journal;
  engine -> ui [label="poll: geänderte Aufträge", style=dashed]; ui -> plasma;
}
