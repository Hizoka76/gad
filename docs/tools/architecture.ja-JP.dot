// The UI and engine run inside one executable.
digraph architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.5"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="Noto Sans CJK JP", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Noto Sans CJK JP", fontsize=9, color="#526779"];
  input [label="Dolphin / Konqueror / CLI\nGadでコピー・切り取り・貼り付け"];
  socket [label="単一のQtインスタンス\nプライベートUnixソケット"];
  ui [label="ウィンドウ・メニュー・システムトレイ\nQSettingsと行キャッシュ"];
  kio [label="KIO Fuse\nURL → マウント済みパス\nKDE認証", fillcolor="#fff4da"];
  bridge [label="C / JSON境界\nsc_request → sc_free"];
  prep [label="バックグラウンドでの準備\n検証とファイルの走査"];
  engine [label="共有Rust状態\nMutex + Condvar"];
  workers [label="2つのワーカースレッド\nディスクとパスの予約\nコピー・移動・復元"];
  fs [label="ローカルまたはマウント先のファイル\n一時ファイルとバックアップ", fillcolor="#e9f5ec"];
  journal [label="JSONジャーナル\nアトミックな書き込みと同期", fillcolor="#e9f5ec"];
  plasma [label="Plasma JobViewV3\n全体の進行状況", fillcolor="#fff4da"];
  input -> socket; socket -> ui; ui -> kio [label="リモートの接続先"]; kio -> ui [label="パス"];
  ui -> bridge; bridge -> engine; engine -> prep; prep -> engine;
  engine -> workers; workers -> fs; workers -> journal; engine -> journal;
  engine -> ui [label="poll: 変更されたリクエスト", style=dashed]; ui -> plasma;
}
