// Request states; individual files have additional states described in the guide.
digraph cycle {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.40"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  scan [label="scanning\nPreparação"];
  waiting [label="waiting\nFila e controlos de pausa"];
  running [label="running\nThread reservada"];
  device [label="device_waiting\nMontagem indisponível",fillcolor="#fff4da"];
  done [label="done", fillcolor="#e9f5ec"];
  error [label="error", fillcolor="#ffe9e7"];
  cancel [label="cancelled", fillcolor="#fff4da"];
  undo [label="undoing\nAcesso exclusivo"];
  undone [label="undone", fillcolor="#e9f5ec"];
  undoerr [label="undo_error", fillcolor="#ffe9e7"];
  scan -> waiting [label="Pedido validado"]; scan -> error [label="Recusado"]; scan -> cancel [label="Cancelado"];
  waiting -> running [label="Recursos compatíveis"]; waiting -> cancel [label="Cancelado"];
  running -> done [label="Concluído"]; running -> waiting [label="Próximo ramo / reagendamento"];
  running -> device [label="Desligado"]; scan -> device [label="Montagem conhecida ausente"];
  device -> waiting [label="Montagem e ficheiros verificados"]; device -> error [label="Recuperação recusada"]; device -> cancel [label="Cancelado"];
  running -> error [label="Erro"]; running -> cancel [label="Parado"];
  done -> undo [label="Restaurar"]; error -> undo [label="Restaurar / repetir ficheiros com erro"]; error -> scan [label="Repetir preparação vazia"]; cancel -> undo;
  undo -> undone [label="Restaurado"]; undo -> undoerr [label="Proteção / erro"]; undoerr -> undo [label="Repetir"];
  undo -> waiting [label="Repetição / reativação preparadas"];
}
