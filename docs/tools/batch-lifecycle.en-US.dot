// Request states; individual files have additional states described in the guide.
digraph cycle {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.40"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  scan [label="scanning\nPreparation"];
  waiting [label="waiting\nQueue + pause controls"];
  running [label="running\nWorker reserved"];
  device [label="device_waiting\nMount unavailable",fillcolor="#fff4da"];
  done [label="done", fillcolor="#e9f5ec"];
  error [label="error", fillcolor="#ffe9e7"];
  cancel [label="cancelled", fillcolor="#fff4da"];
  undo [label="undoing\nExclusive"];
  undone [label="undone", fillcolor="#e9f5ec"];
  undoerr [label="undo_error", fillcolor="#ffe9e7"];
  scan -> waiting [label="Validated request"]; scan -> error [label="Rejected"]; scan -> cancel [label="Canceled"];
  waiting -> running [label="Compatible resources"]; waiting -> cancel [label="Canceled"];
  running -> done [label="Success"]; running -> waiting [label="Next branch / rescheduling"];
  running -> device [label="Disconnected"]; scan -> device [label="Known mount missing"];
  device -> waiting [label="Mount and files revalidated"]; device -> error [label="Recovery refused"]; device -> cancel [label="Canceled"];
  running -> error [label="Failure"]; running -> cancel [label="Stopped"];
  done -> undo [label="Undo"]; error -> undo [label="Undo / retry failed files"]; error -> scan [label="Retry empty preparation"]; cancel -> undo;
  undo -> undone [label="Restored"]; undo -> undoerr [label="Protection / failure"]; undoerr -> undo [label="Retry"];
  undo -> waiting [label="Retry / reactivation prepared"];
}
