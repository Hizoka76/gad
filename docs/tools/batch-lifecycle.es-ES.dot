// Request states; individual files have additional states described in the guide.
digraph cycle {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.40"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  scan [label="scanning\nPreparación"];
  waiting [label="waiting\nCola y controles de pausa"];
  running [label="running\nHilo reservado"];
  device [label="device_waiting\nMontaje no disponible",fillcolor="#fff4da"];
  done [label="done", fillcolor="#e9f5ec"];
  error [label="error", fillcolor="#ffe9e7"];
  cancel [label="cancelled", fillcolor="#fff4da"];
  undo [label="undoing\nAcceso exclusivo"];
  undone [label="undone", fillcolor="#e9f5ec"];
  undoerr [label="undo_error", fillcolor="#ffe9e7"];
  scan -> waiting [label="Solicitud validada"]; scan -> error [label="Rechazado"]; scan -> cancel [label="Cancelado"];
  waiting -> running [label="Recursos compatibles"]; waiting -> cancel [label="Cancelado"];
  running -> done [label="Completado"]; running -> waiting [label="Siguiente rama / replanificación"];
  running -> device [label="Desconectado"]; scan -> device [label="Montaje conocido ausente"];
  device -> waiting [label="Montaje y archivos verificados"]; device -> error [label="Recuperación rechazada"]; device -> cancel [label="Cancelado"];
  running -> error [label="Error"]; running -> cancel [label="Detenido"];
  done -> undo [label="Restaurar"]; error -> undo [label="Restaurar / reintentar errores"]; error -> scan [label="Reintentar preparación vacía"]; cancel -> undo;
  undo -> undone [label="Restaurado"]; undo -> undoerr [label="Protección / error"]; undoerr -> undo [label="Reintentar"];
  undo -> waiting [label="Reintento / reactivación preparados"];
}
