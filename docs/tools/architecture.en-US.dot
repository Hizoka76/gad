// The UI and engine run inside one executable.
digraph architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.5"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#355d88", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#526779"];
  input [label="Dolphin / CLI\nCopy, Cut, Paste with Gad"];
  socket [label="Single Qt instance\nPrivate Unix socket"];
  ui [label="Window, menus, and system tray\nQSettings + row cache"];
  kio [label="KIO Fuse\nURL → mounted path\nKDE authentication", fillcolor="#fff4da"];
  bridge [label="C / JSON boundary\nsc_request → sc_free"];
  prep [label="Background preparation\nValidation + scanning"];
  engine [label="Shared Rust state\nMutex + Condvar"];
  workers [label="Two workers\nDisk and path reservations\nCopy / move / undo"];
  fs [label="Local or mounted files\nTemporary files + backups", fillcolor="#e9f5ec"];
  journal [label="JSON journal\nAtomic write + synchronization", fillcolor="#e9f5ec"];
  plasma [label="Plasma JobViewV3\nCombined progress", fillcolor="#fff4da"];
  input -> socket; socket -> ui; ui -> kio [label="Remote endpoints"]; kio -> ui [label="Paths"];
  ui -> bridge; bridge -> engine; engine -> prep; prep -> engine;
  engine -> workers; workers -> fs; workers -> journal; engine -> journal;
  engine -> ui [label="poll: changed requests", style=dashed]; ui -> plasma;
}
